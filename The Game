from pathlib import Path

html = r'''<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Parking Tycoon '96</title>
<style>
:root{--ink:#202b35;--cream:#f6e9c8;--orange:#e8793e;--green:#4b9a67;--blue:#4b91b9}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#c4d9b5;font-family:Tahoma,Verdana,sans-serif;color:var(--ink)}
#app{height:100%;display:flex;flex-direction:column;background:linear-gradient(#a8c9db 0 35%,#c8d8a9 35%)}
.top{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 12px;background:#263b48;color:#fff;border-bottom:4px solid #e8b85b;box-shadow:0 3px 0 #1a2931;z-index:2}
.brand{font-weight:900;letter-spacing:1px;font-size:clamp(14px,2.4vw,22px);text-shadow:2px 2px #17242c}.brand small{display:block;color:#f1c46a;font-size:10px;letter-spacing:2px}
.stats{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.stat{background:#172b36;border:1px solid #5d7480;padding:5px 8px;border-radius:3px;font-size:12px;white-space:nowrap}.stat b{color:#f4ce6e}
main{position:relative;flex:1;min-height:0;overflow:hidden}
canvas{display:block;width:100%;height:100%;touch-action:none;image-rendering:pixelated}
.hint{position:absolute;left:10px;top:10px;max-width:245px;background:#fff4d8eF;border:2px solid #374c4e;padding:8px 10px;font-size:12px;box-shadow:3px 3px #33444b;pointer-events:none;line-height:1.4}
.bottom{background:#e9d9ad;border-top:4px solid #8c7954;padding:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;box-shadow:0 -3px 0 #fff3cf}
.tools{display:flex;gap:6px;flex-wrap:wrap;flex:1}
button{font:700 12px Tahoma,Verdana,sans-serif;border:2px solid #4a4a3e;border-radius:3px;padding:9px 11px;background:#f8efcf;color:#26333b;box-shadow:0 3px 0 #a89b78;cursor:pointer;touch-action:manipulation}
button:active{transform:translateY(2px);box-shadow:0 1px 0 #a89b78}button.active{background:#eaa15d;color:#fff;border-color:#793f29}button.primary{background:#438b62;color:white}button:disabled{opacity:.45}
#message{font-size:11px;min-width:130px;max-width:220px;line-height:1.3}
@media(max-width:600px){.top{padding:7px}.stats{gap:4px}.stat{padding:4px 5px;font-size:10px}.hint{font-size:10px;max-width:190px}.bottom{padding:6px;gap:6px}button{padding:9px 8px;font-size:11px}.tools{gap:5px}#message{width:100%;max-width:none}}
</style>
</head>
<body>
<div id="app">
<header class="top">
  <div class="brand">PARKING TYCOON <small>EST. 1996 • BUILD YOUR EMPIRE</small></div>
  <div class="stats">
    <div class="stat">CASH <b id="cash">$12,000</b></div>
    <div class="stat">DAY <b id="day">1</b></div>
    <div class="stat">PARKED <b id="parked">0 / 0</b></div>
    <div class="stat">REPUTATION <b id="rep">50%</b></div>
  </div>
</header>
<main id="stage">
<canvas id="world" aria-label="Isometric parking tycoon game"></canvas>
<div class="hint" id="hint">Welcome, boss!<br>Choose a tool below, then tap a tile to build. Cars arrive as your car park grows.</div>
</main>
<footer class="bottom">
 <div class="tools">
  <button class="active" data-tool="select">↖ Inspect</button>
  <button data-tool="park">▦ Parking bay · $400</button>
  <button data-tool="road">━ Road · $250</button>
  <button data-tool="tree">♣ Tree · $150</button>
  <button data-tool="lamp">✦ Lamp · $100</button>
  <button data-tool="bulldoze">⌫ Demolish</button>
 </div>
 <button id="next" class="primary">▶ Next day</button>
 <button id="reset">↻ Reset</button>
 <div id="message">Build bays to earn daily income.</div>
</footer>
</div>
<script>
(() => {
const canvas=document.getElementById('world'),ctx=canvas.getContext('2d');
const cashEl=document.getElementById('cash'),dayEl=document.getElementById('day'),parkedEl=document.getElementById('parked'),repEl=document.getElementById('rep'),hint=document.getElementById('hint'),message=document.getElementById('message');
const W=18,H=18; let cash=12000,day=1,rep=50,tool='select',hover=null,offsetX=0,offsetY=0,scale=1;
let grid=[],cars=[],selected=null,traffic=0;
const costs={park:400,road:250,tree:150,lamp:100};
function blank(){return {type:'grass',car:null}}
function init(){grid=Array.from({length:H},()=>Array.from({length:W},blank));cars=[];cash=12000;day=1;rep=50;traffic=0;selected=null;
 // Existing little town edge and road
 for(let x=0;x<W;x++){grid[2][x].type='road';grid[15][x].type='road'}
 for(let y=3;y<15;y++){grid[y][2].type='road'}
 // decorative starter homes on the edge
 [[1,4],[1,7],[1,10],[1,13],[5,1],[9,1],[13,1],[16,4],[16,8],[16,12]].forEach(([x,y])=>grid[y][x].type='house');
 updateUI();draw();message.textContent='Your first lot is waiting. Start building!';}
function resize(){const r=canvas.getBoundingClientRect(),dpr=Math.min(window.devicePixelRatio||1,2);canvas.width=Math.round(r.width*dpr);canvas.height=Math.round(r.height*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);layout();draw()}
function layout(){const cw=canvas.clientWidth,ch=canvas.clientHeight;scale=Math.min(cw/(W*44),ch/(H*25))*0.95;scale=Math.max(.55,Math.min(scale,1.45));offsetX=(cw-(W*32*scale+H*32*scale))/2;offsetY=(ch-(W*16*scale+H*16*scale))/2+8}
function iso(x,y,z=0){return {x:offsetX+(x-y)*32*scale+W*16*scale,y:offsetY+(x+y)*16*scale+z*scale}}
function poly(points,fill,stroke){ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.closePath();ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=1;ctx.stroke()}}
function rect(x,y,w,h,color){ctx.fillStyle=color;ctx.fillRect(x,y,w,h)}
function tile(x,y){const p=iso(x,y);return [{x:p.x,y:p.y},{x:p.x+32*scale,y:p.y+16*scale},{x:p.x,y:p.y+32*scale},{x:p.x-32*scale,y:p.y+16*scale}]}
function drawTile(x,y,t){const p=iso(x,y),s=scale;
 let base=t.type==='road'?'#555c60':t.type==='park'?'#7d8580':'#8ab578';
 if(t.type==='grass'){base=((x+y)%2)?'#8bb77a':'#91bd7f'}
 poly(tile(x,y),base,'#729568');
 if(t.type==='road'){
  // subtle asphalt grain and markings
  if((x+y)%2===0){ctx.strokeStyle='#777d7e';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(p.x-9*s,p.y+16*s);ctx.lineTo(p.x+8*s,p.y+24*s);ctx.stroke()}
  if(y===2||y===15||x===2){ctx.strokeStyle='#e8dba3';ctx.lineWidth=1.5*s;ctx.setLineDash([4*s,4*s]);ctx.beginPath();ctx.moveTo(p.x-12*s,p.y+16*s);ctx.lineTo(p.x+12*s,p.y+16*s);ctx.stroke();ctx.setLineDash([])}
 }else if(t.type==='park'){
  poly([{x:p.x-25*s,y:p.y+13*s},{x:p.x+25*s,y:p.y+13*s},{x:p.x+14*s,y:p.y+20*s},{x:p.x-14*s,y:p.y+20*s}],'#44494a');
  ctx.strokeStyle='#f2e7bc';ctx.lineWidth=1.4*s;ctx.beginPath();ctx.moveTo(p.x-17*s,p.y+14*s);ctx.lineTo(p.x-10*s,p.y+18*s);ctx.moveTo(p.x+17*s,p.y+14*s);ctx.lineTo(p.x+10*s,p.y+18*s);ctx.stroke();
  if(t.car)drawCar(p,t.car);
 }else if(t.type==='tree'){
  // trunk + layered low-poly foliage
  rect(p.x-2*s,p.y+7*s,4*s,12*s,'#765038');
  poly([{x:p.x,y:p.y-15*s},{x:p.x-13*s,y:p.y+6*s},{x:p.x+13*s,y:p.y+6*s}],'#347b4e','#275d3c');
  poly([{x:p.x,y:p.y-8*s},{x:p.x-10*s,y:p.y+10*s},{x:p.x+10*s,y:p.y+10*s}],'#4b9a5d');
 }else if(t.type==='lamp'){
  rect(p.x-1*s,p.y-2*s,2*s,18*s,'#3e4d51');rect(p.x-4*s,p.y-5*s,8*s,4*s,'#ffdf76');rect(p.x-3*s,p.y-4*s,6*s,2*s,'#fff4bd');
 }else if(t.type==='house')drawHouse(p);
 if(hover&&hover.x===x&&hover.y===y){poly(tile(x,y),'#ffffff33','#fff6a6')}
}
function drawHouse(p){const s=scale;
 poly([{x:p.x-17*s,y:p.y+8*s},{x:p.x,y:p.y+17*s},{x:p.x+17*s,y:p.y+8*s},{x:p.x,y:p.y}],'#e8d1a0','#8a7656');
 poly([{x:p.x-15*s,y:p.y+7*s},{x:p.x,y:p.y-7*s},{x:p.x+15*s,y:p.y+7*s},{x:p.x,y:p.y+16*s}],'#d66c54','#994e40');
 poly([{x:p.x-15*s,y:p.y+7*s},{x:p.x,y:p.y+16*s},{x:p.x,y:p.y+1*s},{x:p.x-15*s,y:p.y-7*s}],'#f3dfb6','#9d8a6a');
 poly([{x:p.x,y:p.y+16*s},{x:p.x+15*s,y:p.y+7*s},{x:p.x+15*s,y:p.y-7*s},{x:p.x,y:p.y+1*s}],'#d7bd8b','#9d8a6a');
 rect(p.x-3*s,p.y+6*s,5*s,8*s,'#715b48');
}
function drawCar(p,color){const s=scale;
 // tiny retro isometric car
 poly([{x:p.x-16*s,y:p.y+14*s},{x:p.x,y:p.y+22*s},{x:p.x+16*s,y:p.y+14*s},{x:p.x,y:p.y+7*s}], '#343b3e');
 poly([{x:p.x-14*s,y:p.y+11*s},{x:p.x,y:p.y+18*s},{x:p.x+14*s,y:p.y+11*s},{x:p.x,y:p.y+4*s}],color,'#343b3e');
 poly([{x:p.x-8*s,y:p.y+8*s},{x:p.x,y:p.y+3*s},{x:p.x+8*s,y:p.y+8*s},{x:p.x,y:p.y+13*s}],'#a8d5dc','#52656b');
 poly([{x:p.x-8*s,y:p.y+8*s},{x:p.x,y:p.y+13*s},{x:p.x,y:p.y+18*s},{x:p.x-8*s,y:p.y+13*s}],color);
 rect(p.x-12*s,p.y+12*s,3*s,3*s,'#20292d');rect(p.x+9*s,p.y+12*s,3*s,3*s,'#20292d');
}
function draw(){
 if(!canvas.width)return;const cw=canvas.clientWidth,ch=canvas.clientHeight;ctx.clearRect(0,0,cw,ch);
 // distant skyline
 for(let i=0;i<13;i++){let x=((i*91+17)%Math.max(1,cw));let h=(i%4+2)*8;rect(x,Math.max(0,ch*.16-h),18,h,['#92b3ba','#a5c0c3','#83a7ae'][i%3]);rect(x+4,Math.max(0,ch*.16-h+5),3,3,'#e9dfaa')}
 // far to near for iso depth
 for(let sum=0;sum<W+H;sum++)for(let y=0;y<H;y++){let x=sum-y;if(x>=0&&x<W)drawTile(x,y,grid[y][x])}
 // selected tile marker
 if(selected){poly(tile(selected.x,selected.y),'#ffd76a22','#ffe07b')}
}
function screenToTile(px,py){let best=null,dist=Infinity;for(let y=0;y<H;y++)for(let x=0;x<W;x++){const p=iso(x,y),dx=Math.abs(px-p.x),dy=Math.abs(py-(p.y+16*scale));if(dx/(32*scale)+dy/(16*scale)<=1.03){const d=dx+dy;if(d<dist){dist=d;best={x,y}}}}return best}
function messageSet(s){message.textContent=s;hint.innerHTML=s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\n/g,'<br>')}
function act(pos){if(!pos)return;const t=grid[pos.y][pos.x];selected=pos;
 if(tool==='select'){messageSet(t.type==='park'?`Parking bay${t.car?' • car parked':''}\nEarns $180 per day when occupied.`:`Tile: ${t.type}\nChoose a building tool to develop it.`);draw();return}
 if(tool==='bulldoze'){if(t.type==='grass'){messageSet('That tile is already empty.');return}if(t.type==='road'||t.type==='house'){messageSet('Town roads and homes are protected.');return}cash+=Math.floor((costs[t.type]||100)*.25);grid[pos.y][pos.x]=blank();messageSet('Cleared the tile. Salvage sold for 25%.');}
 else {if(t.type!=='grass'){messageSet('This tile is occupied. Demolish it first.');return}const cost=costs[tool];if(cash<cost){messageSet('Not enough cash. Collect income by advancing a day.');return}cash-=cost;t.type=tool;if(tool==='park')t.car=null;messageSet(({park:'Parking bay built. Cars will use it as demand grows.',road:'Road laid. Connect your lot to the town.',tree:'Tree planted. A little greenery improves the area.',lamp:'Street lamp installed.'})[tool]);}
 updateUI();draw()}
function updateUI(){cashEl.textContent='$'+Math.floor(cash).toLocaleString();dayEl.textContent=day;const bays=grid.flat().filter(t=>t.type==='park').length;const occupied=grid.flat().filter(t=>t.type==='park'&&t.car).length;parkedEl.textContent=`${occupied} / ${bays}`;repEl.textContent=rep+'%';document.querySelector('#next').disabled=false}
canvas.addEventListener('pointermove',e=>{const r=canvas.getBoundingClientRect();hover=screenToTile(e.clientX-r.left,e.clientY-r.top);draw()});
canvas.addEventListener('pointerleave',()=>{hover=null;draw()});
canvas.addEventListener('pointerdown',e=>{const r=canvas.getBoundingClientRect();act(screenToTile(e.clientX-r.left,e.clientY-r.top))});
document.querySelectorAll('[data-tool]').forEach(b=>b.addEventListener('click',()=>{tool=b.dataset.tool;document.querySelectorAll('[data-tool]').forEach(x=>x.classList.toggle('active',x===b));const labels={select:'Inspect buildings and tiles.',park:'Tap an empty grass tile to build a paid parking bay.',road:'Tap an empty tile to lay a road.',tree:'Tap an empty tile to plant a tree.',lamp:'Tap an empty tile to install a lamp.',bulldoze:'Tap a building to demolish it and recover some money.'};messageSet(labels[tool]);}));
document.getElementById('next').addEventListener('click',()=>{
 day++;const bays=grid.flat().filter(t=>t.type==='park');const roads=grid.flat().filter(t=>t.type==='road').length;
 // demand rises gradually; cars occupy available spaces with a chance of leaving
 let arrivals=0;for(const b of bays){if(b.car&&Math.random()<.3)b.car=null;if(!b.car&&Math.random()<Math.min(.92,.22+day*.018+rep*.002)){b.car=['#d85e4e','#e6bd54','#5689b9','#e9e2c7','#5e9a72','#7c6bb0'][Math.floor(Math.random()*6)];arrivals++}}
 const occupied=bays.filter(b=>b.car).length;const income=occupied*180;cash+=income;
 // upkeep and public sentiment
 const upkeep=roads*8+grid.flat().filter(t=>t.type==='lamp'||t.type==='tree').length*3;cash-=upkeep;
 rep=Math.max(5,Math.min(99,rep+(roads>4?1:0)+(occupied>bays.length*.6?1:0)-(bays.length>3&&roads<4?2:0)));
 updateUI();draw();messageSet(`Day ${day}: earned $${income.toLocaleString()} from ${occupied} parked cars.\nUpkeep: $${upkeep}. ${arrivals?'New drivers arrived!':'Quiet day on the lot.'}`);
});
document.getElementById('reset').addEventListener('click',()=>{if(confirm('Start a new parking empire? Your current city will be lost.'))init()});
window.addEventListener('resize',resize);init();resize();
})();
</script>
</body></html>'''
path = Path("/mnt/data/parking_tycoon_96.html")
path.write_text(html, encoding="utf-8")
print(f"Created playable game: {path} ({path.stat().st_size:,} bytes)")
